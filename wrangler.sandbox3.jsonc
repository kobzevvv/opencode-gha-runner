    "GITHUB_REF": "main",
    "PUBLIC_BASE_URL": "https://trained-assist-native-worker-sandbox3.skillset-apply.workers.dev",
    "AGENT_BINARY": "opencode"
  },
  "observability": {
    "enabled": true
  }
}
